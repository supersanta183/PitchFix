{
  "name": "pitchfix",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "stamp": "node scripts/stamp-version.mjs",
    "prestart": "npm run stamp",
    "start": "ng serve",
    "prebuild": "npm run stamp",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run stamp",
    "test": "ng test",
    "pretest:e2e": "npm run stamp",
    "test:e2e": "playwright test",
    "release": "npm version minor -m \"Release v%s\" && npx vercel --prod --yes",
    "release:major": "npm version major -m \"Release v%s\" && npx vercel --prod --yes"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "pitchy": "^4.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
